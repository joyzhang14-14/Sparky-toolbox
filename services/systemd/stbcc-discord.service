# stbcc-discord：Discord 渠道（channels/discord/service.py；Gateway 长连接，owner 私信与卡片按钮转给聊天中枢 stbcc-hub；规格 11.7）。由 `stb discord --install` 填充 {STB}/{REPO} 后装到 ~/.config/systemd/user/
[Unit]
Description=sparky-toolbox discord adapter (gateway connection, relays to stbcc-hub)
After=network-online.target

[Service]
UMask=0022
Type=simple
WorkingDirectory={REPO}
ExecStart={STB} discord
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
