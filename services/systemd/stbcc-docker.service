# stbcc-docker：起容器的启动器（control_center/docker_service.py）。工具（sparky + Landlock）和 stbcc-builder 只经 data/sockets/stbcc-docker.sock 请它代起容器，
# 它按 tool.yaml 的 docker 校验、加资源上限、随所属运行结束停容器。由 `stb docker --install` 填充 {STB}/{REPO} 后装到 ~/.config/systemd/user/
[Unit]
Description=sparky-toolbox container launcher (stbcc-docker)
After=network-online.target

[Service]
UMask=0022
Type=simple
WorkingDirectory={REPO}
ExecStart={STB} docker serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
