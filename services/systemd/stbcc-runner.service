# stbcc-runner：常驻串行执行器（规格第 9 节）。由 `stb runner --install` 填充 {STB}/{REPO} 后装到 ~/.config/systemd/user/
[Unit]
Description=sparky-toolbox runner (serial task executor)
After=network.target docker.service

[Service]
UMask=0022
Type=simple
WorkingDirectory={REPO}
ExecStart={STB} runner
Restart=on-failure
RestartSec=5
# 停止时只给 runner 发 SIGTERM，之后再统一杀本单元剩下的进程；每次运行在自己的临时单元 stb-run-* 里，运行器停止或重启都不打断它，下次启动接管（规格 9.3、D18）
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
