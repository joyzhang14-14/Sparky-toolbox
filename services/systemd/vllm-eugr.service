# vLLM（eugr 配方，容器 vllm_node）开机自启：等 docker 就绪后跑 ~/scripts/vllm-eugr.sh（脚本末尾会自动设 memory.high=80G）。
# 安装：cp services/systemd/vllm-eugr.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now vllm-eugr
# 停止：systemctl --user stop vllm-eugr（docker rm -f vllm_node；里面跑的是无审查版时不删）。手动重启模型也走这个单元，不要直接跑脚本，否则两边状态不一致。
[Unit]
Description=vLLM Flash-Next (eugr recipe, container vllm_node)
After=network-online.target

[Service]
UMask=0022
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do docker info >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=%h/scripts/vllm-eugr.sh
ExecStop=%h/scripts/vllm-eugr.sh stop
TimeoutStartSec=180

[Install]
WantedBy=default.target
