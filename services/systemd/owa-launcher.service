# systemd 用户单元：open-web-access 宿主启动服务
# 安装：`stb launcher --install`（填充 {REPO} 后装到 ~/.config/systemd/user/ 并启动）
[Unit]
Description=open-web-access launcher (spawns one-shot research containers)

[Service]
UMask=0022
Type=simple
WorkingDirectory={REPO}
ExecStart=/usr/bin/node {REPO}/services/owa-launcher/server.ts
Restart=on-failure
RestartSec=3
# 端口、并发、上限、内存守卫、研究容器的默认沙箱都在 config/stbcc.yaml 的 launcher 段（server.ts 启动时读），这里不写 Environment

[Install]
WantedBy=default.target
